---
import Layout from '../layouts/Layout.astro';

const columnCount = 2;

type TGalleryPhoto = {
  src: string;
  small: string;
  medium: string;
};

const shuffle = <T,>(items: T[], shouldShuffle = true): T[] => {
  const array = [...items];

  if (!shouldShuffle) {
    return array;
  }

  for (let index = array.length - 1; index > 0; index -= 1) {
    const randomIndex = Math.floor(Math.random() * (index + 1));
    [array[index], array[randomIndex]] = [array[randomIndex], array[index]];
  }

  return array;
};

const galleryPhotos = Object.values(import.meta.glob('/public/gallery/small/*.jpg', { eager: true })) as Array<{
  default: string | { src?: string };
}>;
const photos: TGalleryPhoto[] = shuffle(
  galleryPhotos
    .map((entry) => {
      const src = typeof entry.default === 'string' ? entry.default : entry.default?.src;
      if (!src) return null;

      const filename = src.split('/').pop();
      if (!filename) return null;

      return {
        src: `/gallery/medium/${filename}`,
        small: `/gallery/small/${filename}`,
        medium: `/gallery/medium/${filename}`
      };
    })
    .filter((photo): photo is TGalleryPhoto => Boolean(photo)),
  true
);
const photosPerColumn = Math.ceil(photos.length / columnCount);

const columns = Array.from({ length: columnCount }, (_, columnIndex) => {
  const start = columnIndex * photosPerColumn;
  const end = start + photosPerColumn;

  return photos.slice(start, end).map((photo) => ({ ...photo }));
});
---

<Layout>
  <article class='gallery' style={`--column-count: ${columnCount};`}>
    {
      columns.map((column) => (
        <section class='column'>
          {column.map(({ src, small, medium }) => (
            <img
              src={src}
              srcset={`${medium} 1080w, ${small} 540w`}
              sizes='(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
              alt='Gallery photo'
              loading='lazy'
            />
          ))}
        </section>
      ))
    }
  </article>
</Layout>

<style lang='scss'>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    align-items: start;

    @media screen and (width > 768px) {
      grid-template-columns: repeat(var(--column-count), minmax(0, 1fr));
    }
  }

  .column {
    display: grid;
    gap: var(--space-2);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
