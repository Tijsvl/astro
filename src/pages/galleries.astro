---
import Layout from '@layouts/Layout.astro';
import H1 from '@components/H1.astro';
import { db } from '@firebase/firebase.server';
import { galleryUrl, type Gallery } from '../data/galleries.ts';
import { galleryDateToUnix } from '@utils/date';
import { prettyDate } from '@utils/prettyDate';
import { countryCode } from '@utils/countryCode';
import { slug } from '@utils/slug.js';
import '/node_modules/flag-icons/css/flag-icons.min.css';

type GalleryDocument = {
  artist: string;
  date: string;
  venue: string;
  city: string;
  country: string;
  festival: boolean;
};

const galleries: Gallery[] = [];

const querySnapshot = await db.collection('galleries').get();

querySnapshot.forEach((doc) => {
  const { artist, date, venue, city, country, festival } = doc.data() as GalleryDocument;
  const unix = galleryDateToUnix(date);

  galleries.push({
    name: artist,
    date,
    unix,
    venue,
    city,
    country,
    festival
  });
});

galleries.sort((left, right) => right.unix - left.unix);
---

<Layout>
  <H1>Galleries</H1>
  <!-- <div class='search'>
    Search: <input type='search' />
  </div> -->
  <table>
    <thead>
      <tr>
        <th scope='col'><button type='button' data-sort-key='artist'>Artist</button></th>
        <th scope='col' data-show='small medium'><button type='button' data-sort-key='location'>Location</button></th>
        <th scope='col' data-show='large'><button type='button' data-sort-key='venue'>Venue</button></th>
        <th scope='col'><button type='button' data-sort-key='date' aria-sort='descending'>Date</button></th>
        <th scope='col' data-show='large'><button type='button' data-sort-key='city'>City</button></th>
        <th scope='col' class='country'><div><button type='button' data-sort-key='country'>Country</button></div></th>
      </tr>
    </thead>
    <tbody>
      {
        galleries.map((gallery, idx) => (
          <tr
            data-index={idx}
            data-sort-artist={gallery.name}
            data-sort-location={gallery.festival ? gallery.venue : gallery.city}
            data-sort-venue={gallery.venue}
            data-sort-date={gallery.unix}
            data-sort-city={gallery.city}
            data-sort-country={gallery.country}
          >
            <td class='artist'>
              <a href={galleryUrl(gallery)} aria-label={gallery.name} transition:name=`${'title-' + slug(gallery.name+'-'+gallery.date)}`  />
              {gallery.name}
            </td>
            <td class='location' data-show='small medium'>
              {gallery.festival ? gallery.venue : gallery.city}
            </td>
            <td class='venue' data-show='large'>
              {gallery.venue}
            </td>
            <td class='date'>
              <time datetime={prettyDate(gallery.date, 'html')}>
                <span data-show='small'>{prettyDate(gallery.date, 'numeric')}</span>
                <span data-show='medium'>{prettyDate(gallery.date, 'short')}</span>
                <span data-show='large'>{prettyDate(gallery.date)}</span>
              </time>
            </td>
            <td class='city' data-show='large'>
              {gallery.city}
            </td>
            <td class='country'>
              <div>
                <span data-show='medium large'>{gallery.country}</span>
                <span
                  data-show='small'
                  aria-label={gallery.country}
                  class={`fi fi-${countryCode(gallery.country)}`}
                  title={gallery.country}
                />
              </div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <style lang='scss'>
    .search {
      display: flex;
      align-items: center;
      justify-content: end;
      margin-bottom: var(--space-6);
      gap: var(--space-4);
    }

    th button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      margin-bottom: var(--space-2);
    }

    [aria-sort]::after {
      content: '';
      width: 0.65em;
      height: 0.65em;
      display: block;
      mask-image: var(--i-chevron);
      mask-position: center;
      mask-repeat: no-repeat;
      mask-size: contain;
      background-color: currentColor;
      transition: rotate 0.15s ease-out;
    }

    [aria-sort='descending']::after {
      rotate: 180deg;
    }

    table {
      width: 100%;
      font-size: var(--font-4);
      border-spacing: 0;

      @media screen and (width < 560px) {
        font-size: var(--font-3);
      }

      th {
        font-weight: 600;
      }

      th,
      td {
        text-align: left;
        padding-inline: calc(var(--page-spacing) / 2);
        padding-block: var(--space-1);
      }

      th {
        padding-top: 0;
      }

      tbody tr {
        isolation: isolate;
        position: relative;

        // TODO: Make the effect work when hovering from both top and bottom so that it looks like a nice flow
        &::after {
          background-color: var(--c-ink-subtle-2);
          content: '';
          position: absolute;
          height: 1px;
          inset: auto calc(var(--page-spacing) / 2) 0;
          transition:
            height 0.2s ease-in-out,
            inset 0.1s ease-in-out;
          z-index: -1;
        }

        &:hover {
          &::after {
            content: '';
            position: absolute;
            height: 100%;
            inset: auto calc(var(--page-spacing) * -1) 0;
            transition:
              height 0.4s ease-in-out,
              inset 0.2s ease-in-out;
          }
        }

        a {
          position: absolute;
          inset: 0;
          display:inline-block;
        }
      }

      td {
        border-bottom: 1px solid rgba(0 0 0 / 0);
      }
    }

    [data-show] {
      display: none;
    }

    @media screen and (width < 768px) {
      [data-show*='small'] {
        display: block;
      }
    }

    @media screen and (width >= 768px) and (width < 1000px) {
      [data-show*='medium'] {
        display: block;
      }
    }

    @media screen and (width >= 1000px) {
      [data-show*='large'] {
        display: block;
      }
    }

    @media screen and (width < 768px) {
      .country > div {
        display: flex;
        justify-content: center;
      }
    }

    .fi {
      margin: 0;
      outline: 1px solid var(--c-ink-subtle-2);
    }
  </style>

  <script>
    // @ts-nocheck

    const table = document.querySelector('table');
    const sortButtons = Array.from(document.querySelectorAll('button[data-sort-key]'));

    if (table && table.tBodies[0] && sortButtons.length) {
      const tbody = table.tBodies[0];
      const collator = new Intl.Collator(undefined, {
        numeric: true,
        sensitivity: 'base'
      });

      const getDatasetKey = (sortKey) => `sort${sortKey.charAt(0).toUpperCase()}${sortKey.slice(1)}`;

      const getRowValue = (row, sortKey) => row.dataset[getDatasetKey(sortKey)] ?? '';

      const updateHeaderState = (activeButton, direction) => {
        sortButtons.forEach((button) => {
          if (button === activeButton) {
            button.setAttribute('aria-sort', direction);
          } else {
            button.removeAttribute('aria-sort');
          }
        });
      };

      const sortRows = (sortKey, direction) => {
        const rows = Array.from(tbody.rows);

        rows.sort((leftRow, rightRow) => {
          const leftValue = getRowValue(leftRow, sortKey);
          const rightValue = getRowValue(rightRow, sortKey);

          const comparison =
            sortKey === 'date' ? Number(leftValue) - Number(rightValue) : collator.compare(leftValue, rightValue);

          if (comparison !== 0) {
            return direction === 'ascending' ? comparison : -comparison;
          }

          return Number(leftRow.dataset.index ?? 0) - Number(rightRow.dataset.index ?? 0);
        });

        tbody.append(...rows);
      };

      const activeButton = sortButtons.find((button) => button.hasAttribute('aria-sort')) ?? sortButtons[0];
      const activeSortKey = activeButton.dataset.sortKey;
      const activeDirection = activeButton.getAttribute('aria-sort') === 'ascending' ? 'ascending' : 'descending';

      updateHeaderState(activeButton, activeDirection);
      sortRows(activeSortKey, activeDirection);

      sortButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const sortKey = button.dataset.sortKey;
          const isActive = button.hasAttribute('aria-sort');
          const currentDirection = button.getAttribute('aria-sort') === 'ascending' ? 'ascending' : 'descending';
          const nextDirection = isActive
            ? currentDirection === 'ascending'
              ? 'descending'
              : 'ascending'
            : sortKey === 'date'
              ? 'descending'
              : 'ascending';

          updateHeaderState(button, nextDirection);
          sortRows(sortKey, nextDirection);
        });
      });
    }
  </script>
</Layout>
