---
import CloseIcon from '@svg/CloseIcon.astro';
import ChevronIcon from '@svg/ChevronIcon.astro';

type MasonryImage = {
  file: string;
  type?: string;
  aspectRatio: string;
};

type Props = {
  data: {
    images?: MasonryImage[];
    artist: string;
    venue?: string;
    city?: string;
    artistSlug?: string;
    citySlug?: string;
    date?: string;
  };
};

const { data } = Astro.props as Props;
const { images = [], artist, venue, city, artistSlug, citySlug, date } = data;
const masonryImages = images.filter((image) => !image.type || image.type === 'image');
masonryImages.sort((a, b) => a.file.localeCompare(b.file));

const prefix = `https://tijsvl.b-cdn.net/galleries/${artistSlug}/${citySlug}/${date}`;
---

<section data-masonry data-masonry-length={masonryImages.length}>
  <div>
    {
      masonryImages.map((item) => (
        <div data-masonry-item style={`--a: ${item.aspectRatio ?? '1'}`}>
          <figure>
            <picture>
              <source srcset={`${prefix}/${item.file.replace('.jpg', '_medium.jpg')}`} media='(min-width: 330px)' />
              <source srcset={`${prefix}/${item.file.replace('.jpg', '_small.jpg')}`} media='(min-width: 115px)' />
              <img
                src={`${prefix}/${item.file.replace('.jpg', '_medium.jpg')}`}
                alt={artist}
                style={`--a: ${item.aspectRatio ?? '1'}`}
                loading='lazy'
              />
            </picture>
            <figcaption>{artist}</figcaption>
          </figure>
          <button
            aria-label='Open photo'
            data-photo={prefix + '/' + item.file.replace('.jpg', '_medium.jpg')}
            data-photo-key={item.file}
          />
        </div>
      ))
    }
  </div>
</section>

<dialog id='dialog' data-artist={artist} data-venue={venue ?? ''} data-city={city ?? ''}>
  <button class='dialog-close' commandfor='dialog' command='close' aria-label='Close dialog'><CloseIcon /></button>
  <div class='dialog-photo-caption'>
    <strong data-photo-artist>{artist}</strong>
    <span data-photo-venue>{[venue, city].filter(Boolean).join(', ')}</span>
  </div>
  <section></section>
  <div class='dialog-meta'>
    <button type='button' class='dialog-nav prev' data-dialog-nav='prev' aria-label='Previous photo'><ChevronIcon /></button>
    <div class='dialog-copy'>
      <div class='dialog-download'>
        <a data-dialog-download href='' aria-label='Download photo'>Download photo</a>

        <div class='dialog-thanks' data-dialog-thanks aria-hidden='true'>
          <p>Thanks for downloading!</p>
          <a href='https://buymeacoffee.com/tijsvl' target='_blank'><img src='/images/beer-button.png' /></a>
          <a href='/copyright' target='_blank'>Am I allowed to use this photo?</a>
        </div>
      </div>
      <span class='dialog-index' data-photo-index>1 / 1</span>
    </div>
    <button type='button' class='dialog-nav next' data-dialog-nav='next' aria-label='Next photo'><ChevronIcon /></button>
  </div>
  <template id='dialog-custom-slide-template'>
    <div class='dialog-custom-slide'>
      <div class='dialog-custom-inner'>
        <h2>Like my work?</h2>
        <p>Please consider making a small contribution to keep me going :)</p>
        <div>
          <a href='https://buymeacoffee.com/tijsvl' target='_blank'><img src='/images/beer-button.png' /></a>
          <a class='qr' href='https://buymeacoffee.com/tijsvl' target='_blank'><img src='/images/beer-qr.png' /></a>
        </div>
      </div>
    </div>
  </template>
</dialog>

<script>
  // @ts-nocheck

  /**
   * @param {() => void} fn
   * @param {number} wait
   */
  const debounce = (fn, wait) => {
    /** @type {ReturnType<typeof window.setTimeout> | undefined} */
    let timeoutId;

    return () => {
      if (timeoutId !== undefined) {
        window.clearTimeout(timeoutId);
      }

      timeoutId = window.setTimeout(fn, wait);
    };
  };

  let masonryResizeHandlerAttached = false;

  /**
   * @param {HTMLElement} masonryContainer
   */
  const initMasonry = (masonryContainer) => {
    /** @type {HTMLElement | null} */
    const masonry = masonryContainer.firstElementChild;

    if (!masonry) {
      return;
    }

    const initialized = masonryContainer.getAttribute('data-masonry') === 'initialized';
    /** @type {HTMLElement | null} */
    let masonryShadow = masonryContainer.querySelector('[masonry-shadow]');

    if (!initialized) {
      masonryShadow = masonry.cloneNode(true);
      masonryShadow.setAttribute('masonry-shadow', '');
      masonryShadow.setAttribute('aria-hidden', 'true');
      masonryContainer.appendChild(masonryShadow);
    }

    if (!masonryShadow) {
      return;
    }

    masonry.setAttribute('masonry-view', '');

    const xStart = masonry.getBoundingClientRect().left;
    const yStart = masonry.offsetTop;
    const masonryWidth = masonry.clientWidth;
    /** @type {HTMLElement[]} */
    const masonryItems = Array.from(masonry.querySelectorAll(':scope [data-masonry-item]'));

    masonryItems.forEach((el, key) => {
      el.setAttribute('masonry-id', `id_${key + 1}`);
      el.style.setProperty('--d', String(key + 1));
    });

    const masonryItemById = new Map(masonryItems.map((item) => [item.getAttribute('masonry-id'), item]));

    /** @type {{ element: HTMLElement; y: number }[]} */
    const shadowItems = [];
    /** @type {HTMLElement[]} */
    const masonryShadowItems = [...masonryShadow.querySelectorAll(':scope [data-masonry-item]')];

    masonryShadowItems.forEach((el, key) => {
      el.style.removeProperty('--p');
      el.setAttribute('masonry-id', `id_${key + 1}`);
      shadowItems.push({ element: el, y: el.offsetTop - yStart });
    });

    if (!shadowItems.length) {
      masonryContainer.setAttribute('data-masonry', 'initialized');
      masonry.style.setProperty('--h', `${masonryShadow.clientHeight}px`);
      return;
    }

    /** @type {{ element: HTMLElement; y: number }[][]} */
    const rows = [];
    const rowTolerance = 1; // pixels
    let rowIndex = 0;

    while (rowIndex < shadowItems.length) {
      const baseY = shadowItems[rowIndex].y;
      const currentRow = [shadowItems[rowIndex]];
      rowIndex += 1;

      while (rowIndex < shadowItems.length && Math.abs(shadowItems[rowIndex].y - baseY) <= rowTolerance) {
        currentRow.push(shadowItems[rowIndex]);
        rowIndex += 1;
      }

      rows.push(currentRow);
    }

    rows.forEach((row, idx) => {
      const isLastRow = rows.length - 1 === idx;
      const xEnd = Math.ceil(row[row.length - 1].element.getBoundingClientRect().right);
      const rowWidth = xEnd - xStart;
      let difference = +(masonryWidth / rowWidth).toFixed(5);

      if (isLastRow) {
        difference = difference > 1.5 ? 1.5 : difference;
      }

      row.forEach((item, key) => {
        const { element } = item;
        const isLast = row.length - 1 === key;
        element.style.setProperty('--p', String(difference));

        const viewItem = masonryItemById.get(element.getAttribute('masonry-id'));

        if (viewItem) {
          const x = (element.getBoundingClientRect().x - xStart).toFixed(2);
          const y = (element.offsetTop - yStart).toFixed(2);
          let w = `${element.clientWidth}px`;
          const h = `${element.clientHeight}px`;

          if (!isLast) {
            viewItem.removeAttribute('masonry-last');
          } else if (!isLastRow) {
            viewItem.setAttribute('masonry-last', '');
            viewItem.style.setProperty('--r', '0');
            w = 'auto';
          }

          viewItem.style.setProperty('--x', `${x}px`);
          viewItem.style.setProperty('--y', `${y}px`);
          viewItem.style.setProperty('--w', w);
          viewItem.style.setProperty('--h', h);
        }
      });
    });

    masonry.style.setProperty('--h', `${masonryShadow.clientHeight}px`);
    masonryContainer.setAttribute('data-masonry', 'initialized');
  };

  const initAllMasonry = () => {
    document.querySelectorAll('[data-masonry]').forEach((masonryContainer) => {
      initMasonry(masonryContainer);
    });
  };

  const onReady = () => {
    initAllMasonry();

    if (!masonryResizeHandlerAttached) {
      masonryResizeHandlerAttached = true;
      window.addEventListener('resize', debounce(initAllMasonry, 100));
    }
  };

  if (document.readyState === 'complete') onReady();
  else window.addEventListener('load', onReady, { once: true });

  document.addEventListener('astro:page-load', initAllMasonry);

  const dialog = document.querySelector('dialog');
  const dialogContent = dialog.querySelector('section') as HTMLElement;
  const photoArtist = dialog.querySelector('[data-photo-artist]') as HTMLElement;
  const photoVenue = dialog.querySelector('[data-photo-venue]') as HTMLElement;
  const photoIndex = dialog.querySelector('[data-photo-index]') as HTMLElement;
  const dialogCopy = dialog.querySelector('.dialog-copy') as HTMLElement;
  const dialogDownload = dialog.querySelector('[data-dialog-download]') as HTMLAnchorElement | null;
  const dialogPhotoCaption = dialog.querySelector('.dialog-photo-caption') as HTMLElement;

  const getPhotoButtons = () =>
    Array.from(document.querySelectorAll('button[data-photo-key]')).filter(
      (button) => !button.closest('[masonry-shadow]')
    ) as HTMLButtonElement[];

  const CUSTOM_SLIDE_KEY = '__custom__';

  const getSlides = () => {
    const photoButtons = getPhotoButtons();

    return [
      ...photoButtons.map((button) => ({ type: 'photo', key: button.getAttribute('data-photo-key') ?? '', button })),
      { type: 'custom', key: CUSTOM_SLIDE_KEY }
    ];
  };

  const getPhotoCount = () => document.querySelector('[data-masonry]')?.getAttribute('data-masonry-length') ?? 0;

  const updateDialogUrl = (photoKey) => {
    const url = new URL(window.location.href);

    if (photoKey) {
      url.searchParams.set('photo', photoKey);
    } else {
      url.searchParams.delete('photo');
    }

    window.history.pushState({}, '', `${url.pathname}${url.search}`);
  };

  const updatePhotoMeta = (photoButton) => {
    const artist = dialog.getAttribute('data-artist') ?? '';
    const venue = dialog.getAttribute('data-venue') ?? '';
    const city = dialog.getAttribute('data-city') ?? '';
    const slides = getSlides();
    const totalPhotos = getPhotoCount();
    const currentKey = photoButton?.getAttribute('data-photo-key') ?? dialog.getAttribute('data-photo-key') ?? null;

    photoArtist.textContent = artist;
    photoVenue.textContent = [venue, city].filter(Boolean).join(', ');

    if (currentKey === CUSTOM_SLIDE_KEY) {
      photoIndex.textContent = `${totalPhotos} / ${totalPhotos}`;
    } else if (currentKey) {
      const photoPosition = slides.findIndex(
        (slide) => slide.key === currentKey || (slide.type === 'photo' && decodeURIComponent(currentKey) === slide.key)
      );
      const safeIndex = photoPosition > -1 ? photoPosition + 1 : 1;
      photoIndex.textContent = `${safeIndex} / ${totalPhotos}`;
    } else {
      photoIndex.textContent = `1 / ${totalPhotos}`;
    }

    if (photoButton) {
      const photoKey = photoButton.getAttribute('data-photo-key');
      dialog.dataset.photoKey = photoKey ?? '';
    }
  };

  const renderCustomSlide = ({ updateUrl = true } = {}) => {
    const customTemplate = document.getElementById('dialog-custom-slide-template');
    const customHtml = customTemplate?.innerHTML ?? '<div class="dialog-custom-slide"><p>Custom content</p></div>';

    dialog.classList.add('is-custom');
    dialogCopy.style.display = 'none';
    dialogPhotoCaption.style.display = 'none';
    if (dialogDownload) {
      dialogDownload.style.display = 'none';
    }

    dialogContent.innerHTML = customHtml;
    dialog.showModal();
    dialog.dataset.photoKey = CUSTOM_SLIDE_KEY;
    photoIndex.textContent = '';

    if (updateUrl) {
      updateDialogUrl(CUSTOM_SLIDE_KEY);
    }
  };

  const openPhotoDialog = (photoButton, { updateUrl = true } = {}) => {
    const photo = photoButton.getAttribute('data-photo');
    const photoKey = photoButton.getAttribute('data-photo-key') ?? photo?.split('/').pop() ?? null;

    if (!photo || !photoKey) return;

    dialog.classList.remove('is-custom');
    dialogCopy.style.display = 'flex';
    dialogPhotoCaption.style.display = 'flex';
    if (dialogDownload) {
      dialogDownload.href = `${photo}?download`;
      dialogDownload.style.display = 'inline-flex';
    }

    const aspectRatio = photoButton.parentElement?.getAttribute('style')?.match(/--a:\s*([^;]+)/)?.[1] ?? '1';
    dialogContent.innerHTML = `<img src="${photo}" alt="${dialog.getAttribute('data-artist') ?? 'Gallery photo'}" style="--ar: ${aspectRatio};" />`;
    dialog.showModal();
    updatePhotoMeta(photoButton);

    if (updateUrl) {
      updateDialogUrl(photoKey);
    }
  };

  const closePhotoDialog = () => {
    if (dialog.open) {
      dialog.close();
    }

    dialog.classList.remove('is-custom');
    updateDialogUrl(null);
    dialog.removeAttribute('data-photo-key');
  };

  const openPhotoFromUrl = () => {
    const photoKey = new URLSearchParams(window.location.search).get('photo');

    if (!photoKey) return;

    if (photoKey === CUSTOM_SLIDE_KEY) {
      renderCustomSlide({ updateUrl: false });
      return;
    }

    const photoButton = getPhotoButtons().find((button) => {
      const currentKey = button.getAttribute('data-photo-key');
      return currentKey === photoKey || (currentKey && decodeURIComponent(photoKey) === currentKey);
    });

    if (!photoButton) return;

    openPhotoDialog(photoButton, { updateUrl: false });
  };

  const navigateToPhoto = (direction) => {
    const photoButtons = getPhotoButtons();

    if (!photoButtons.length) return;

    const currentKey = dialog.getAttribute('data-photo-key');

    const dialogThanks = document.querySelector('[data-dialog-thanks]') as HTMLElement | null;
    dialogThanks?.setAttribute('aria-hidden', 'true');

    if (currentKey === CUSTOM_SLIDE_KEY) {
      const fallbackButton = direction > 0 ? photoButtons[0] : photoButtons[photoButtons.length - 1];
      if (fallbackButton) {
        openPhotoDialog(fallbackButton);
      }
      return;
    }

    const currentIndex = photoButtons.findIndex((button) => {
      const buttonKey = button.getAttribute('data-photo-key');
      return buttonKey === currentKey || (buttonKey && decodeURIComponent(currentKey ?? '') === buttonKey);
    });

    if (currentIndex === -1) {
      const fallbackButton = direction > 0 ? photoButtons[0] : photoButtons[photoButtons.length - 1];
      openPhotoDialog(fallbackButton);
      return;
    }

    if (direction > 0) {
      if (currentIndex === photoButtons.length - 1) {
        renderCustomSlide();
        return;
      }

      openPhotoDialog(photoButtons[currentIndex + 1]);
      return;
    }

    if (currentIndex === 0) {
      renderCustomSlide();
      return;
    }

    openPhotoDialog(photoButtons[currentIndex - 1]);
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (!target) return;

    const dialogNavButton = target!.closest('[data-dialog-nav]') as HTMLButtonElement | null;
    if (dialogNavButton) {
      if (dialogNavButton.dataset.dialogNav === 'next') {
        navigateToPhoto(1);
      }

      if (dialogNavButton.dataset.dialogNav === 'prev') {
        navigateToPhoto(-1);
      }

      return;
    }

    const photoButton = target!.closest('button[data-photo]') as HTMLButtonElement;
    if (photoButton) {
      openPhotoDialog(photoButton);
    }

    const downloadButton = target!.closest('[data-dialog-download]') as HTMLAnchorElement | null;
    const dialogThanks = document.querySelector('[data-dialog-thanks]') as HTMLElement | null;

    if (downloadButton) {
      dialogThanks?.setAttribute('aria-hidden', 'false');
      e.preventDefault();
      setTimeout(() => (window.location.href = (target as HTMLLinkElement).href), 1000);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog.open) return;

    if (event.key === 'ArrowRight') {
      event.preventDefault();
      navigateToPhoto(1);
    }

    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      navigateToPhoto(-1);
    }
  });

  dialog.addEventListener('close', () => {
    const url = new URL(window.location.href);

    if (url.searchParams.has('photo')) {
      updateDialogUrl(null);
    }

    dialog.removeAttribute('data-photo-key');

    const dialogThanks = document.querySelector('[data-dialog-thanks]') as HTMLElement | null;
    dialogThanks?.setAttribute('aria-hidden', 'true');
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) {
      closePhotoDialog();
    }
  });

  document.addEventListener('astro:page-load', () => {
    initAllMasonry();
    openPhotoFromUrl();
  });

  if (document.readyState === 'complete') {
    onReady();
    openPhotoFromUrl();
  } else {
    window.addEventListener(
      'load',
      () => {
        onReady();
        openPhotoFromUrl();
      },
      { once: true }
    );
  }
</script>

<style lang='scss'>
  section {
    isolation: isolate;
  }

  section button {
    background: transparent;
    position: absolute;
    inset: 0;
    z-index: 99;
  }

  dialog {
    border: 0;
    background: transparent;
    padding: 0;
    max-width: min(92vw, 1100px);
    width: min(92vw, 1100px);
    color: var(--c-text);

    &.is-custom {
      .dialog-copy,
      [data-dialog-download],
      .dialog-photo-caption {
        display: none;
      }

      .dialog-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
    }
  }

  .dialog-photo-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-3);
    color: white;
    text-align: center;

    strong {
      font-size: var(--font-4);
    }

    span {
      font-size: var(--font-2);
      opacity: 0.9;
    }
  }

  .dialog-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: var(--space-6);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: white;
    cursor: pointer;
  }

  .dialog-meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    color: var(--c-white);
  }

  .dialog-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
  }

  .dialog-index {
    font-size: var(--font-1);
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  .dialog-nav {
    color: white;

    :global(svg) {
      margin-inline: auto;
    }

    &.prev {
      justify-self: start;

      :global(svg) {
        rotate: 180deg;
      }
    }

    &.next {
      justify-self: end;
    }
  }

  .dialog-download {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
    white-space: nowrap;
    text-decoration: none;
    position: relative;
  }

  .dialog-thanks {
    position: absolute;
    left: 50%;
    bottom: 4rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--c-white);
    color: var(--c-black);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--space-2);
    opacity: 0;
    transform-origin: left bottom;
    transition:
      opacity 0.3s ease,
      bottom 0.3s ease;
    pointer-events: none;
    user-select: none;

    p {
      margin: 0;
    }

    img {
      width: 100%;
      max-width: 200px;
    }
  }

  .dialog-thanks[aria-hidden='false'] {
    pointer-events: auto;
    opacity: 1;
    bottom: 5rem;
  }

  .dialog-custom-slide {
    display: grid;
    place-items: center;
    min-height: min(70vh, 600px);
    background: rgba(0, 0, 0, 0.9);
    border-radius: 1rem;
    text-align: center;
    padding: 2rem;
    color: white;
    position: relative;
  }

  .dialog-custom-inner {
    display: grid;
    gap: 0.75rem;
    max-width: 30rem;

    h2 {
      text-transform: revert;
      font-size: var(--font-7);
      margin: 0;
    }

    p {
      margin: 0;
      text-wrap: balance;
      margin-bottom: var(--space-5);
    }

    div {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);

      img {
        width: 100%;
        max-width: 100%;
        height: auto;
        aspect-ratio: auto;
        border: 0;
      }
    }
  }

  section {
    background: rgba(0, 0, 0, 0.9);
    overflow: hidden;
    padding: 0;

    img {
      display: block;
      width: 100%;
      height: auto;
      max-height: min(82vh, 900px);
      aspect-ratio: var(--ar, 1);
      object-fit: cover;
    }
  }

  :global([data-masonry]) {
    --_size: 320px;
    --_size: 15vw;
    --_gap: 0.5rem;
    --_transition-duration: 2.4s;
    --_transition-timing: cubic-bezier(0.16, 1, 0.3, 1);
    --_animation-delay: 100ms;

    position: relative;
    margin-block: var(--space-6);
    visibility: hidden;

    &:has([masonry-shadow]) {
      visibility: visible;
    }

    @media (max-width: 1280px) {
      --_size: 17.5vw;
    }

    @media (max-width: 1000px) {
      --_size: 20vw;
    }

    @media (max-width: 768px) {
      --_size: 25vw;
    }

    @media (max-width: 640px) {
      --_size: 35vw;
    }

    :global([masonry-view] [data-masonry-item]),
    :global([masonry-shadow] [data-masonry-item]) {
      height: calc(var(--_size) * var(--p, 1));
      position: relative;
    }

    figure {
      position: relative;
      width: 100%;
      height: 100%;
    }

    img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    :global([masonry-view]) {
      opacity: 1;
      transform: translateY(-5vw);
      animation: slideIn;
      animation-duration: var(--_transition-duration);
      animation-fill-mode: forwards;
      width: 100%;

      > [data-masonry-item] {
        position: absolute;
        top: var(--y, 20px);
        left: var(--x, 20px);
        right: var(--r, auto);
        width: var(--w, 20px);
        height: var(--h, 20px);
        transition:
          top var(--_transition-duration) var(--_transition-timing),
          left calc(var(--_transition-duration) / 2) var(--_transition-timing);
        animation: fadeIn;
        animation-duration: var(--_transition-duration);
        animation-fill-mode: forwards;
        animation-delay: calc(var(--d, 1) * var(--_animation-delay) / 4);
        opacity: 0.01;

        &::before {
          content: '';
          display: block;
          position: absolute;
          inset: calc(var(--_gap) * -1);
          background-color: var(--c-paper);
          pointer-events: none;
          z-index: -1;
        }

        img {
          transition: filter 0.15s ease-out;
          will-change: scale;
        }

        &:hover img {
          filter: brightness(1.25);
        }
      }

      img {
        opacity: 1;
        aspect-ratio: var(--a, auto);
      }

      figcaption {
        position: absolute;
